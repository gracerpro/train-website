{
  "name": "train-website",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "build": "npm run type-check && npm run build:client && npm run build:server",
    "build:client": "tsc && vite build --outDir dist/client --ssrManifest .vite/ssr-manifest.json",
    "build:server": "tsc && vite build --outDir dist/server --ssr src/entry-server.js",
    "generate": "tsc && vite build --outDir dist/static --ssrManifest .vite/ssr-manifest.json && npm run build:server && npm run generate-only",
    "generate-only": "NODE_ENV=production ts-node --project tsconfig.ssg.json prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ server.ts prerender.ts",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.8.0",
    "express": "^5.0.1",
    "node-fetch": "^3.3.2",
    "pinia": "^4.0.2",
    "sirv": "^3.0.1",
    "vue": "^3.5.40",
    "vue-component-type-helpers": "^3.3.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/bootstrap": "^5.2.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "node-gzip": "^1.1.2",
    "prettier": "^3.3.3",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
